# frozen_string_literal: true
# Desktop Manager — ambiente de testes (Windows 11 + Google Chrome)
#
# Pré-requisitos no host:
#   - Vagrant >= 2.3  https://developer.hashicorp.com/vagrant/install
#   - VirtualBox >= 7  https://www.virtualbox.org/ (ou Hyper-V no Windows Pro)
#
# Uso:
#   cd test/vagrant
#   vagrant up
#   vagrant rdp          # ou abra a janela do VirtualBox
#   vagrant halt
#   vagrant destroy -f

Vagrant.configure("2") do |config|
  # Box Windows 11 mantida pela comunidade (WinRM + usuário vagrant/vagrant)
  # https://portal.cloud.hashicorp.com/vagrant/discover/gusztavvargadr/windows-11
  config.vm.box = "gusztavvargadr/windows-11"
  config.vm.hostname = "dm-test-win11"

  config.vm.guest = :windows
  config.vm.communicator = "winrm"
  config.winrm.username = "vagrant"
  config.winrm.password = "vagrant"
  config.winrm.timeout = 1800
  config.winrm.retry_limit = 30
  config.vm.boot_timeout = 1800

  # Rede NAT padrão + porta RDP encaminhada (opcional)
  config.vm.network "forwarded_port", guest: 3389, host: 13389, id: "rdp", auto_correct: true

  # Pasta do projeto no guest (somente leitura do código; release fica gravável)
  project_root = File.expand_path("../..", __dir__)
  config.vm.synced_folder project_root, "C:/desktop-manager",
                          create: true,
                          SharedFoldersEnableSymlinksCreate: false

  # Pasta de trabalho para testes manuais
  config.vm.synced_folder File.expand_path("../workspace", __dir__), "C:/dm-test",
                          create: true

  config.vm.provider "virtualbox" do |vb|
    vb.name = "desktop-manager-win11-test"
    vb.gui = true
    vb.memory = ENV.fetch("DM_VM_MEMORY", "8192")
    vb.cpus = ENV.fetch("DM_VM_CPUS", "2").to_i
    vb.customize ["modifyvm", :id, "--vram", "128"]
    vb.customize ["modifyvm", :id, "--clipboard", "bidirectional"]
    vb.customize ["modifyvm", :id, "--draganddrop", "bidirectional"]
    vb.customize ["modifyvm", :id, "--nested-hw-virt", "on"]
    # Acelera boot em hosts com VT-x/AMD-V
    vb.customize ["modifyvm", :id, "--accelerate3d", "on"]
  end

  config.vm.provider "hyperv" do |hv|
    hv.vmname = "desktop-manager-win11-test"
    hv.memory = ENV.fetch("DM_VM_MEMORY", "8192").to_i
    hv.cpus = ENV.fetch("DM_VM_CPUS", "2").to_i
    hv.enable_virtualization_extensions = true
  end

  # Provisionamento: Chocolatey → Chrome → preparação do ambiente de teste
  config.vm.provision "shell",
                      name: "base",
                      path: "provision/01-base.ps1",
                      privileged: true

  config.vm.provision "shell",
                      name: "chrome",
                      path: "provision/02-chrome.ps1",
                      privileged: true

  config.vm.provision "shell",
                      name: "ready",
                      path: "provision/03-ready.ps1",
                      privileged: true
end
