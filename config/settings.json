{
  "enabled": true,
  "wallpaper": {
    "enabled": true,
    "auto_aspect": true,
    "image_4x3": "assets/wallpaper/desktop-4x3.jpg",
    "image_16x9": "assets/wallpaper/desktop-16x9.jpg",
    "image": "",
    "style": "fill"
  },
  "organize_desktop": {
    "enabled": true,
    "rules": {
      "Documents": [".pdf", ".doc", ".docx", ".txt", ".xls", ".xlsx", ".ppt", ".pptx", ".odt", ".rtf", ".csv"],
      "Pictures": [".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".svg", ".ico", ".heic"],
      "Videos": [".mp4", ".avi", ".mkv", ".mov", ".wmv", ".webm"],
      "Music": [".mp3", ".wav", ".flac", ".aac", ".ogg", ".m4a", ".wma"],
      "Downloads": [".zip", ".rar", ".7z", ".exe", ".msi", ".iso", ".dmg"]
    },
    "keep_shortcuts": ["word", "excel", "powerpoint", "chrome"],
    "remove_other_shortcuts": true,
    "create_subfolder_by_date": false
  },
  "browser": {
    "set_default": false,
    "default_browser": "chrome",
    "clear_data": {
      "enabled": true,
      "browsers": ["chrome", "edge", "firefox"],
      "clear_cache": true,
      "clear_cookies": false,
      "clear_history": false
    }
  },
  "taskbar": {
    "enabled": true,
    "replace": true,
    "pins": ["explorer", "word", "excel", "powerpoint", "chrome"],
    "pin": [],
    "unpin": []
  },
  "triggers": {
    "on_startup": true,
    "on_shutdown": true
  },
  "logging": {
    "level": "INFO",
    "keep_days": 30
  }
}
